  },
  "devDependencies": {
    "@types/leaflet": "1.9.22",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
